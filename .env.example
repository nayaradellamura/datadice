# Cada jogador usa a própria chave do Gemini, em Configurações no navegador.
# Esta chave serve só para "npm run models" (manutenção); o servidor não a usa no jogo.
GEMINI_API_KEY=

# Banco PostgreSQL. Local: postgres://usuario:senha@127.0.0.1:5433/datadice
# Na hospedagem, use a URL do provedor com ?sslmode=require no final.
DATABASE_URL=
# Quantos proxies há na frente do servidor na hospedagem: 1 (só a hospedagem) ou 2 (Cloudflare + hospedagem).
# No seu computador, deixe vazio.
TRUST_PROXY=
# Espaço de imagens por conta, em MB (padrão 100).
MAX_USER_IMAGE_MB=
# Só para copiar seus dados para a nuvem (scripts/copiar-para-nuvem.ps1): URL DIRETA do Neon, sem "-pooler".
CLOUD_DATABASE_URL=
# Banco só para "npm test". Precisa ser OUTRO banco (os testes criam e apagam esquemas temporários nele).
TEST_DATABASE_URL=
# Conexões abertas ao mesmo tempo com o banco (padrão 10).
DATABASE_POOL_SIZE=10

PORT=3000
# 127.0.0.1 = só este computador. Na hospedagem, use 0.0.0.0 atrás de HTTPS.
HOST=127.0.0.1
# 1 quando houver um proxy HTTPS na frente (quase toda hospedagem).
TRUST_PROXY=0

GEMINI_MODEL=gemini-3.5-flash-lite
# Sem plano gratuito: cerca de US$ 0,034 por imagem.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# Segredo dos tokens de login, com 32 caracteres ou mais. Vazio: criado sozinho em data/jwt-secret.
JWT_SECRET=
# Código de convite do Beta. Vazio: qualquer pessoa que acessar pode criar conta.
REGISTRATION_CODE=

# Conta admin inicial (só na primeira vez, se ainda não houver admin). Apague a senha depois.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
